# Vorlage — nach .env kopieren und ausfüllen. .env ist gitignored (NIE committen).
#   cp .env.example .env

# Pflicht: Schlüssel von https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Standardmodell, wenn --model fehlt
# MODEL_REVIEW_MODEL=openai/gpt-5.1

# Optional: Kostenbremse pro Modell und Lauf (USD, Schätzung VOR dem Aufruf)
# MODEL_REVIEW_MAX_COST_USD=1.0

# Optional: maximale Antwortlänge / maximale Paketgröße
# MODEL_REVIEW_MAX_TOKENS=8000
# MODEL_REVIEW_MAX_CONTEXT_CHARS=320000

# Optional: 1 = auch Anbieter zulassen, die Eingaben zum Training sammeln dürfen
# MODEL_REVIEW_ALLOW_DATA_COLLECTION=0
